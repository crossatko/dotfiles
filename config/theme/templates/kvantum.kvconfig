# generated by ~/.config/theme/theme.py -- do not edit
# Overrides for the generated Kvantum theme "Wall" (~/.config/Kvantum/Wall): theme.py takes Kvantum's KvFlat
# (kvconfig + SVG, recoloured to the palette) and puts these keys on top. Glass: Kvantum makes Qt windows
# translucent (WA_TranslucentBackground) and Hyprland draws the glass behind them (tint / darkening from
# Settings > Glass); Kvantum's own blur is off. Window background = the shell's card fill (theme.toml
# gtk_glass_* like GTK: reduce_window_opacity = 100 - card fill), menus = gtk_glass_popover.
# Colours with alpha are Qt's #AARRGGBB.
[%General]
translucent_windows=true
blurring=false
popup_blurring=false
blur_translucent=false
reduce_window_opacity={{kv_window_reduce}}
reduce_menu_opacity={{kv_menu_reduce}}
menu_shadow_depth=0
tooltip_shadow_depth=0
transparent_dolphin_view=false
respect_DE=false
# libadwaita geometry (the design reference, measured: AGENTS.md "Design match"); shapes / fills in kvantum_svg.py
normal_default_pushbutton=false
groupbox_top_label=true
slider_width=4
slider_handle_width=20
slider_handle_length=20
scroll_width=8
scroll_min_extent=40
transient_scrollbar=true
check_size=20
progressbar_thickness=8
spread_progressbar=true
menu_separator_height=13
spread_menuitems=true
tooltip_shadow_depth=0
splitter_width=1
small_icon_size=16
toolbar_icon_size=16
button_icon_size=16
large_icon_size=32
layout_spacing=6
layout_margin=12
toolbar_interior_spacing=5
toolbar_item_spacing=6
spin_button_width=33
button_contents_shift=false
combo_menu=true
hide_combo_checkboxes=true
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,VirtualBoxVM,dragon,digikam,lyx,obs,quickshell,qs,qrenderdoc,krita

[GeneralColors]
window.color={{bg}}
base.color=#{{kv_view_alpha}}{{bg_alt.bare}}
alt.base.color=#{{kv_view_alpha}}{{surface.bare}}
button.color=#{{kv_control_alpha}}{{fg.bare}}
light.color={{overlay}}
mid.light.color={{surface2}}
dark.color={{bg}}
mid.color={{surface2}}
highlight.color={{accent}}
inactive.highlight.color={{accent_soft}}
text.color={{fg}}
window.text.color={{fg}}
button.text.color={{fg}}
disabled.text.color={{muted}}
tooltip.text.color={{fg}}
highlight.text.color={{bg}}
link.color={{accent2}}
link.visited.color={{magenta}}
progress.indicator.text.color={{fg}}

# --- libadwaita-style widget sections (merged over the base theme's) ---
[PanelButtonCommand]
frame=true
frame.element=button
interior.element=button
frame.top=6
frame.bottom=6
frame.left=9
frame.right=9
text.margin.top=0
text.margin.bottom=0
text.margin.left=8
text.margin.right=8
text.normal.color={{fg}}
text.focus.color={{fg}}
text.press.color={{fg}}
text.toggle.color={{fg}}
text.shadow=0
text.bold=true
min_height=34
min_width=34
frame.expansion=18
text.default.color={{bg}}

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.bold=false
min_height=34
min_width=34
text.margin.left=0
text.margin.right=0
frame.top=9
frame.bottom=9
[ToolbarButton]
inherits=PanelButtonTool

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.bold=false
text.margin.left=9
text.margin.right=9
min_height=34
text.margin.top=0
text.margin.bottom=0
frame.top=7
frame.bottom=7
frame.left=9
frame.right=9
[ComboBox]
inherits=PanelButtonCommand
text.bold=true
min_height=34
frame.top=7
frame.bottom=7
[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6
text.bold=false
text.toggle.color={{fg}}
text.press.color={{fg}}
min_height=38
text.iconspacing=12

[GenericFrame]
frame=true
interior=false
frame.element=common
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[Menu]
