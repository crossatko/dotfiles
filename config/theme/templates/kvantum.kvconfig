frame.bottom=12
frame.left=12
frame.right=12
text.margin.top=0
text.margin.bottom=6
text.margin.left=0
text.margin.right=0
text.bold=true
min_height=0
min_width=0

# no dashed focus rectangles on rows / buttons (libadwaita shows focus rings only for keyboard focus; entries
# keep their accent ring from lineedit-focused)
[Focus]
frame=false
