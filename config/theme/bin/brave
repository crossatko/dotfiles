#!/usr/bin/env bash
# Launcher shim (symlinked to ~/.local/bin/brave, ahead of /usr/bin in PATH).
# Brave rewrites its Preferences on exit, so the wallpaper theme can only be written
# while it is NOT running -- i.e. right here, just before it starts.
if ! pgrep -x brave >/dev/null 2>&1; then
  python3 -I "$HOME/.config/theme/theme.py" brave >/dev/null 2>&1 || true
fi
# Chromium's GTK file dialogs (Open / Save) ignore ~/.config/gtk-3.0 settings and user CSS but obey
# GTK_THEME, so point them at the generated "Wall" theme. Set only for Brave: a global GTK_THEME
# would also hit libadwaita apps (Nautilus), which treat it as "use a non-Adwaita stylesheet".
# brave_mode = "gtk" in theme.toml: Brave runs in GTK mode (theme.py brave sets it in Preferences) and takes its
# frame colours from "Wall-Glass" = Wall + translucent header bars, so the tab strip shows the window glass.
# (theme.local.toml, this machine's override, wins over the tracked theme.toml)
# Light / dark: the mode theme.py keeps in its state file (default dark); ":dark" picks GTK's dark variant of the theme.
if [ "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/theme/mode" 2>/dev/null)" = light ]; then variant=""; else variant=":dark"; fi
brave_mode=$(grep -hE '^brave_mode *= *"' "$HOME/.config/theme/theme.local.toml" "$HOME/.config/theme/theme.toml" 2>/dev/null | head -n 1)
if case "$brave_mode" in *'"gtk"'*) true ;; *) false ;; esac \
   && [ -f "$HOME/.local/share/themes/Wall-Glass/gtk-3.0/gtk.css" ]; then
  export GTK_THEME=Wall-Glass$variant
else
  export GTK_THEME=Wall$variant
fi
exec /usr/bin/brave "$@"
