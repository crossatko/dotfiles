# Czech Diacritics Helper — OpenRouter API Key
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Home Assistant webhook — posted to by scripts/tv-webhook-notify.sh whenever
# the living room TV's Hyprland output becomes active/inactive (see tv.lua).
HA_TV_WEBHOOK_URL=

# Home Assistant webhook — posted to by scripts/gamescope-webhook-notify.sh
# whenever gamescope becomes/stops being what's on the TV: session start and
# end (gamescope-webhook-notify.service's ExecStart=/ExecStop=) *and* suspend
# and resume within a session (gamescope-sleep-signal-listener.sh). Can reuse
# the same HA webhook endpoint as HA_TV_WEBHOOK_URL if desired -- the JSON
# body's key ("active" here vs. "connected" above) is what distinguishes them.
HA_GAMESCOPE_WEBHOOK_URL=
