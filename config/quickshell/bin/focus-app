#!/usr/bin/env bash
# Focus the window that belongs to a notification's app (Hyprland). Usage:
#   focus-app <desktop-entry> <app-name> [startup-wm-class]
# Scores every window against the hints (class equality > app name in class > app name in title >
# desktop entry in class), prefers a window of the app that is already focused/visible, and focuses
# it by address. Focusing a window inside a Hyprland group makes it the group's active tab and brings
# the group's workspace/monitor to the front, so grouped messaging apps (Discord, WhatsApp, Signal)
# work the same as ungrouped ones. Prints the focused address, exits 1 when nothing matched.
set -uo pipefail
entry=${1:-}; app=${2:-}; wmclass=${3:-}
norm() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/\.desktop$//; s/[[:space:]]\{1,\}/ /g'; }
entry=$(norm "$entry"); app=$(norm "$app"); wmclass=$(norm "$wmclass")
[ -n "$entry$app$wmclass" ] || exit 1

addr=$(hyprctl clients -j | jq -r --arg e "$entry" --arg a "$app" --arg w "$wmclass" '
  def lc: ascii_downcase;
  def has($hay; $n): ($n | length) >= 3 and ($hay | lc | contains($n));
  [ .[] | select(.mapped != false)
    | . as $c
    | ($c.class | lc) as $cl | ($c.initialClass | lc) as $ic | ($c.title | lc) as $t
    | { address: .address, focus: (.focusHistoryID // 99),
        score: (
            (if $w != "" and ($cl == $w or $ic == $w) then 10 else 0 end)
          + (if $e != "" and ($cl == $e or $ic == $e) then 9 else 0 end)
          + (if has($cl; $a) or has($ic; $a) then 8 else 0 end)
          + (if has($t; $a) then 4 else 0 end)
          + (if $e != "" and ($e | length) >= 3 and (($cl | contains($e)) or ($ic | contains($e))) then 3 else 0 end)
        ) }
    | select(.score > 0) ]
  | sort_by([-.score, .focus]) | (.[0].address // empty)')

[ -n "$addr" ] || exit 1
# A focus that crosses monitors / switches a group tab sometimes does not stick on the first try
# (checked live: the window got shown but focus stayed on the previous one), so verify and retry.
for _ in 1 2 3 4; do
  hyprctl dispatch "hl.dsp.focus({window=\"address:$addr\"})" >/dev/null
  sleep 0.12
  [ "$(hyprctl activewindow -j | jq -r '.address // empty')" = "$addr" ] && break
done
echo "$addr"
