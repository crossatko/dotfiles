#!/usr/bin/env python3
"""Wallpaper brightness under the bar, for the bar's adaptive contrast (BarContrast.qml).

  bar-luma <image> <screenW> <screenH> <barPx> <top|bottom> [video]

Prints one JSON line {"cols": [[mean, lo, hi], ...]}: COLS columns across the bar strip (the first/last barPx screen rows on
the bar's edge) of the wallpaper as the desktop shows it (cover-cropped, centred, like hyprpaper's fit_mode = cover), per
column the mean, the darkest tenth (lo) and the brightest tenth (hi) of the pixels as linear relative luminance 0..1.
`video` (optional, a path): the clip's brightness joins the still's: FRAMES evenly spaced frames are decoded once
(ffmpeg) and averaged with the still, so a clip that gets brighter or darker is judged by the whole clip, not one frame.
Runs once per wallpaper / geometry change (the shell caches the result); exit 1 and no output when the image cannot be read.
Needs ImageMagick (magick); ffmpeg/ffprobe only for `video`."""
import json
import subprocess
import sys

COLS = 64
SW = 640          # working width in px: far less than a screen, plenty for the mean of a 40 px strip
FRAMES = 5


def lut():
    f = lambda c: c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    return [f(i / 255) for i in range(256)]


def geometry(w, h, bar_px):
    sh = max(2, round(SW * h / w))
    rows = max(2, min(sh, round(SW * bar_px / w)))
    return SW, sh, rows


def still_pixels(path, w, h, rows, edge):
    """raw rgb24 of the strip (SW x rows) from an image, cover-cropped to the screen aspect"""
    sw, sh, _ = geometry(w, h, 0)
    y = 0 if edge == "top" else sh - rows
    out = subprocess.run(["magick", f"{path}[0]", "-auto-orient", "-background", "black", "-alpha", "remove",
                          "-colorspace", "sRGB", "-type", "TrueColor", "-resize", f"{sw}x{sh}^", "-gravity", "center", "-extent", f"{sw}x{sh}", "+gravity", "+repage",
                          "-crop", f"{sw}x{rows}+0+{y}", "+repage", "-depth", "8", "rgb:-"],
                         check=True, capture_output=True, timeout=30).stdout
    return out


def video_frames(path, w, h, rows, edge):
    sw, sh, _ = geometry(w, h, 0)
    try:
        d = float(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", path],
                                 check=True, capture_output=True, timeout=15).stdout.decode().strip())
    except (subprocess.SubprocessError, OSError, ValueError):
        return []
    y = 0 if edge == "top" else sh - rows
    res = []
    for i in range(FRAMES):
        t = d * (i + 0.5) / FRAMES
        try:
            raw = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{t:.3f}", "-i", path, "-frames:v", "1", "-vf",
                                  f"scale={sw}:{sh}:force_original_aspect_ratio=increase,crop={sw}:{sh},crop={sw}:{rows}:0:{y}",
                                  "-pix_fmt", "rgb24", "-f", "rawvideo", "-"],
                                 check=True, capture_output=True, timeout=20).stdout
        except (subprocess.SubprocessError, OSError):
            continue
        if len(raw) >= sw * rows * 3:
            res.append(raw)
    return res


def columns(raws, rows, table):
    """[[mean, lo, hi]] per column over all frames' pixels (each frame weighs the same)"""
    cols = []
    for c in range(COLS):
        x0, x1 = c * SW // COLS, (c + 1) * SW // COLS
        vals = []
        for raw in raws:
            for r in range(rows):
                base = (r * SW + x0) * 3
                for x in range(x1 - x0):
                    i = base + x * 3
                    vals.append(0.2126 * table[raw[i]] + 0.7152 * table[raw[i + 1]] + 0.0722 * table[raw[i + 2]])
        vals.sort()
        n = len(vals)
        cols.append([round(sum(vals) / n, 4), round(vals[int(n * 0.1)], 4), round(vals[min(n - 1, int(n * 0.9))], 4)])
    return cols


def main(argv):
    if len(argv) < 6 or argv[5] not in ("top", "bottom"):
        return 2
    path, edge = argv[1], argv[5]
    try:
        w, h, bar_px = int(argv[2]), int(argv[3]), int(argv[4])
    except ValueError:
        return 2
    if w < 16 or h < 16 or bar_px < 1:
        return 2
    rows = geometry(w, h, bar_px)[2]
    raws = []
    try:
        raws.append(still_pixels(path, w, h, rows, edge))
    except (subprocess.SubprocessError, OSError):
        raws = []
    if len(argv) > 6 and argv[6]:
        raws += video_frames(argv[6], w, h, rows, edge)
    raws = [r for r in raws if len(r) >= SW * rows * 3]
    if not raws:
        return 1
    print(json.dumps({"cols": columns(raws, rows, lut())}, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
