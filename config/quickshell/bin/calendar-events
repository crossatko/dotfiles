#!/usr/bin/env python3
"""Events for the bar's calendar popup, as JSON, from omacal.

    calendar-events <from YYYY-MM-DD> <to YYYY-MM-DD>     (to is exclusive)

If `omacal` is on PATH and `omacal calendars --json` lists a calendar, events come from `omacal events list`
(read-only CLI, already expanded for recurrence; its --to is inclusive, ours is exclusive). When omacal is missing,
has no calendars or fails, the output is empty with an "error" string.

Output: {"source": "omacal", "events": [{title, start, end, allDay, calendar, color, location}], "calendars": [...], "writable": [{id, name, color, primary}], "error"?: str}
start/end are local "YYYY-MM-DD HH:MM" strings; for all-day events `end` is the (exclusive) last date.
"""
import datetime as dt, json, shutil, subprocess, sys

LOCAL = dt.datetime.now().astimezone().tzinfo



def omacal_json(*args):
    r = subprocess.run(["omacal", *args, "--json"], capture_output=True, text=True, timeout=10)
    d = json.loads(r.stdout)
    if r.returncode != 0 or not d.get("ok"):
        raise RuntimeError("omacal failed")
    return d["data"]


def from_omacal(lo, hi):
    """Output dict from omacal, or None when it is missing, empty or failing (caller reports an error)."""
    if not shutil.which("omacal"):
        return None
    try:
        cals = omacal_json("calendars")
        if not cals:
            return None
        last = (hi - dt.timedelta(days=1)).date()           # omacal's --to is inclusive
        if last < lo.date():
            last = lo.date()
        rows = omacal_json("events", "list", "--from", lo.date().isoformat(), "--to", last.isoformat())
        color = {c["id"]: c.get("color_override") or c.get("color_hex") or "#888888" for c in cals}
        events = []
        for r in rows:
            s, e = dt.datetime.fromisoformat(r["start"]), dt.datetime.fromisoformat(r["end"])
            if not r["allDay"]:
                s, e = s.astimezone(LOCAL), e.astimezone(LOCAL)
            events.append({
                "title": r["title"] or "(no title)",
                "start": s.strftime("%Y-%m-%d %H:%M"),
                "end": e.strftime("%Y-%m-%d %H:%M"),
                "allDay": bool(r["allDay"]),
                "calendar": r.get("calendar") or "",
                "color": color.get(r.get("calendarId"), "#888888"),
                "location": r.get("location") or "",
            })
        events.sort(key=lambda x: (x["start"], x["title"]))
        out_cals = [{"id": str(c["id"]), "name": c.get("label_override") or c.get("summary") or str(c["id"]),
                     "color": color[c["id"]]} for c in cals if c.get("selected", True)]
        # calendars an event can be created in: owner/writer access only (reader = subscriptions, holidays, shared read-only)
        writable = [{"id": c["id"], "name": c.get("label_override") or c.get("summary") or str(c["id"]), "color": color[c["id"]],
                     "primary": bool(c.get("is_primary"))}
                    for c in cals if c.get("selected", True) and c.get("access_role") in ("owner", "writer")]
        return {"source": "omacal", "events": events, "calendars": out_cals, "writable": writable}
    except Exception:
        return None


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    lo = dt.datetime.fromisoformat(sys.argv[1])
    hi = dt.datetime.fromisoformat(sys.argv[2])
    res = from_omacal(lo, hi)
    if res is not None:
        print(json.dumps(res, ensure_ascii=False))
        return
    print(json.dumps({"source": "omacal", "events": [], "calendars": [], "error": "omacal not installed"}))

main()
