#!/usr/bin/env bash
# dmenu-style picker rendered by quickshell (Menu.qml). Reads choices on stdin, prints the
# chosen line, exits 1 if cancelled. Drop-in for `tofi --prompt-text 'X: '`.
prompt="menu: "
while [ $# -gt 0 ]; do
  case "$1" in
    --prompt-text|--prompt) prompt="$2"; shift 2 ;;
    --prompt-text=*|--prompt=*) prompt="${1#*=}"; shift ;;
    *) shift ;;
  esac
done

dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/qmenu.XXXXXX") || exit 1
trap 'rm -rf "$dir"' EXIT
cat > "$dir/items"
mkfifo "$dir/out"

if ! qs ipc call menu dmenu "$prompt" "$dir" >/dev/null 2>&1; then
  # quickshell isn't running: fall back to tofi so a menu never silently vanishes
  tofi --prompt-text "$prompt" < "$dir/items"
  exit $?
fi

# Block until quickshell writes the choice; give up if it dies mid-menu.
cat "$dir/out" > "$dir/result" &
reader=$!
( while kill -0 "$reader" 2>/dev/null; do
    pgrep -x quickshell >/dev/null || { kill "$reader" 2>/dev/null; break; }
    sleep 1
  done ) &
watchdog=$!
wait "$reader"
kill "$watchdog" 2>/dev/null

[ -s "$dir/result" ] || exit 1
cat "$dir/result"
