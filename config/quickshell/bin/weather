#!/usr/bin/env -S python3 -I
"""Current weather, the next hours and a short forecast as JSON on stdout (Weather.qml runs this; `weather | jq` to look).

Data: Open-Meteo (https://open-meteo.com, free, no key): the forecast API and its geocoding API for city names.
Location (--location TEXT):
  ""            automatic: IP geolocation (ipwho.is, keyless; ipapi.co and ipinfo.io as fallbacks), cached for a day
  "lat,lon"     coordinates ("12.5, -34.25"); shown as the neutral name "Custom location"
  anything else a place name, resolved once through Open-Meteo's geocoding API and cached
Units (--units): "metric" (Celsius, km/h; the default) or "imperial" (Fahrenheit, mph). The cache always holds the
metric answer and converts on output, so a units change works offline too.
Other options: --kp (also add the aurora block, see below), --force (ignore the fresh-answer cache), --max-age S (default 600: reuse an answer younger than this).

Output: {ok, stale, error, generatedAt, units, unitsLabel{temp,wind}, location{name,source}, current{...},
hourly[...] (the next 8 hours), daily[...] (today first; rel = 0 today, 1 tomorrow, null later)}. generatedAt is when the
data was fetched (epoch seconds). `kind` is a coarse condition (clear partly cloudy fog drizzle rain showers snow storm)
from the WMO code, the QML side maps it to an icon. On a failure the last good answer for the same location is returned
with stale=true and the error text, but only while it is younger than 24 h (older = ok=false); past days and hours are
dropped from it. Coordinates are never printed; the resolved location and the last answer are cached under
$QS_WEATHER_CACHE (default $XDG_CACHE_HOME/quickshell/weather), outside the repo.
Aurora (--kp, asked for only while Settings > Weather > Weather blur is on): NOAA SWPC's planetary K index (keyless,
https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json, 3-hourly, the last row is the latest), cached 30 min,
adds "aurora": {"kp": number|null, "likely": bool}. `likely` = the Kp reaches the one the location's geomagnetic latitude
needs (REQUIRED_KP). Approximation: centred-dipole geomagnetic latitude (pole 80.7 N, 72.7 W), a coarse latitude -> Kp table
of the usual auroral-oval charts; weather, light pollution and the exact oval are ignored. The coordinates stay inside the
helper: only kp and the boolean are printed. No data (offline, old, bad answer) = kp null, likely false.
Env (tests): QS_WEATHER_MOCK also takes kp.json (the NOAA answer), QS_WEATHER_CACHE (cache dir), QS_WEATHER_MOCK (dir with ip.json, ip2.json / ip3.json (the ipapi.co / ipinfo.io fallbacks),
geocode.json, forecast.json, each = {"status": 200, "body": {...}} used instead of the network; a missing file =
network error).
"""
import datetime
import http.client
import json
import math
import os
import re
import sys
import time
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
CACHE = os.environ.get("QS_WEATHER_CACHE") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "quickshell", "weather")
MOCK = os.environ.get("QS_WEATHER_MOCK") or ""
TIMEOUT = 12
STALE_MAX = 86400.0                   # a stale answer older than this is not shown at all
HOURS = 8                             # hourly entries in the output
CUSTOM = "Custom location"           # name shown for a coordinates override (the numbers are never printed)
KP_TTL = 1800.0                       # NOAA is asked at most every 30 min
KP_OLD = 6 * 3600.0                   # a cached Kp older than this is not used when NOAA does not answer
KP_URL = "https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json"
POLE = (80.7, -72.7)                  # geomagnetic dipole pole (lat, lon), good enough for an oval estimate
# (minimum |geomagnetic latitude| in degrees, Kp needed to see aurora on the horizon there), highest latitude first
REQUIRED_KP = ((66.0, 0), (64.0, 1), (62.0, 2), (60.0, 3), (57.5, 4), (55.0, 5), (52.5, 6), (50.0, 7), (47.0, 8), (45.0, 9))
IP_TTL = 86400.0                      # re-check the IP location once a day (a laptop travels), keep the old one on failure

# WMO weather interpretation code -> (kind, text)
WMO = {
    0: ("clear", "Clear sky"), 1: ("clear", "Mainly clear"), 2: ("partly", "Partly cloudy"), 3: ("cloudy", "Overcast"),
    45: ("fog", "Fog"), 48: ("fog", "Freezing fog"),
    51: ("drizzle", "Light drizzle"), 53: ("drizzle", "Drizzle"), 55: ("drizzle", "Heavy drizzle"),
    56: ("drizzle", "Freezing drizzle"), 57: ("drizzle", "Freezing drizzle"),
    61: ("rain", "Light rain"), 63: ("rain", "Rain"), 65: ("rain", "Heavy rain"),
    66: ("rain", "Freezing rain"), 67: ("rain", "Freezing rain"),
    71: ("snow", "Light snow"), 73: ("snow", "Snow"), 75: ("snow", "Heavy snow"), 77: ("snow", "Snow grains"),
    80: ("showers", "Light showers"), 81: ("showers", "Showers"), 82: ("showers", "Heavy showers"),
    85: ("snow", "Snow showers"), 86: ("snow", "Heavy snow showers"),
    95: ("storm", "Thunderstorm"), 96: ("storm", "Thunderstorm with hail"), 99: ("storm", "Thunderstorm with hail"),
}


def describe(code):
    """(kind, text) of a WMO code; unknown codes read as 'unknown'."""
    return WMO.get(code, ("unknown", "Unknown"))


COORDS = re.compile(r"^\s*(-?\d+(?:\.\d+)?)\s*[,;\s]\s*(-?\d+(?:\.\d+)?)\s*$")


def parse_coords(text):
    """'lat,lon' -> (lat, lon) or None when it is not a valid pair."""
    m = COORDS.match(text or "")
    if not m:
        return None
    lat, lon = float(m.group(1)), float(m.group(2))
    return (lat, lon) if -90 <= lat <= 90 and -180 <= lon <= 180 else None


class Fail(Exception):
    """A failure with a user-facing message."""


def get_json(name, url):
    """GET url as JSON (or the mock file `name`); raises OSError on any network / HTTP / parse failure."""
    try:
        if MOCK:
            with open(os.path.join(MOCK, name + ".json")) as f:
                m = json.load(f)
            if m.get("status", 200) != 200:
                raise OSError("HTTP %s" % m.get("status"))
            return m.get("body")
        req = urllib.request.Request(url, headers={"User-Agent": "quickshell-weather"})
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            return json.load(r)
    except (http.client.HTTPException, ValueError) as e:      # IncompleteRead, bad JSON / encoding
        raise OSError(str(e))


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, path)
    except OSError:
        pass


def _ipinfo(d):
    lat, lon = str(d["loc"]).split(",")
    return float(lat), float(lon), str(d.get("city") or "")


def _latlon(d):
    return float(d["latitude"]), float(d["longitude"]), str(d.get("city") or "")


def _ipwho(d):
    if d.get("success") is False:
        raise ValueError("lookup failed")
    return _latlon(d)


# (mock file, url, parser): first service that answers wins
IP_SERVICES = (
    ("ip", "https://ipwho.is/?fields=success,latitude,longitude,city", _ipwho),
    ("ip2", "https://ipapi.co/json/", _latlon),
    ("ip3", "https://ipinfo.io/json", _ipinfo),
)


def ip_location():
    """(lat, lon, name) from the first keyless IP geolocation service that answers."""
    for name, url, parse in IP_SERVICES:
        try:
            return parse(get_json(name, url))
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
    raise OSError("no IP geolocation service answered")


def geocode(query):
    url = "https://geocoding-api.open-meteo.com/v1/search?count=1&language=en&format=json&name=" + urllib.parse.quote(query)
    body = get_json("geocode", url)
    if not isinstance(body, dict):
        raise OSError("bad geocoding answer")
    res = body.get("results") or []
    if not res:
        raise Fail("Place not found")      # a valid answer without a match, not a fetch error
    r = res[0]
    return float(r["latitude"]), float(r["longitude"]), str(r.get("name") or query)


def resolve(text, now):
    """-> (lat, lon, name, source). Raises Fail on failure."""
    c = parse_coords(text)
    if c:
        return c[0], c[1], CUSTOM, "coords"
    store = load(os.path.join(CACHE, "location.json"))
    if not isinstance(store, dict):
        store = {}
    key = "q:" + text.strip().lower() if text.strip() else "ip"
    hit = store.get(key)
    if hit and (key != "ip" or now - hit.get("at", 0) < IP_TTL):
        return hit["lat"], hit["lon"], hit["name"], hit["source"]
    try:
        if key == "ip":
            lat, lon, name = ip_location()
            src = "ip"
            name = name or "Current location"
        else:
            lat, lon, name = geocode(text.strip())
            src = "search"
    except Fail:
        raise
    except Exception:
        if hit:                      # an old IP location beats none
            return hit["lat"], hit["lon"], hit["name"], hit["source"]
        raise Fail("Location unavailable")
    store[key] = {"lat": lat, "lon": lon, "name": name, "source": src, "at": now}
    save(os.path.join(CACHE, "location.json"), store)
    return lat, lon, name, src


def geomag_lat(lat, lon):
    """Geomagnetic latitude (degrees) of a geographic position, centred-dipole model."""
    p, l0 = math.radians(POLE[0]), math.radians(POLE[1])
    la, lo = math.radians(lat), math.radians(lon)
    return math.degrees(math.asin(max(-1.0, min(1.0, math.sin(la) * math.sin(p) + math.cos(la) * math.cos(p) * math.cos(lo - l0)))))


def kp_needed(lat, lon):
    """The Kp at which aurora is likely at this position, None when it is too far from the oval ever to be."""
    g = abs(geomag_lat(lat, lon))
    for floor, kp in REQUIRED_KP:
        if g >= floor:
            return kp
    return None


def parse_kp(body, now):
    """NOAA planetary-k-index answer -> the latest Kp (float) or None. Rows are {time_tag (UTC), Kp, ...}, oldest first."""
    if not isinstance(body, list):
        return None
    for row in reversed(body):
        try:
            when = datetime.datetime.strptime(str(row["time_tag"])[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc)
            kp = float(row["Kp"])
        except (KeyError, ValueError, TypeError):
            continue
        return kp if 0 <= now - when.timestamp() < KP_OLD and 0 <= kp <= 9 else None
    return None


def current_kp(now):
    """Latest planetary Kp, cached 30 min; None without usable data."""
    path = os.path.join(CACHE, "kp.json")
    cached = load(path)
    if isinstance(cached, dict) and isinstance(cached.get("at"), (int, float)) and 0 <= now - cached["at"] < KP_TTL:
        return cached.get("kp")
    try:
        kp = parse_kp(get_json("kp", KP_URL), now)
    except Exception:
        kp = None
    if kp is None and isinstance(cached, dict) and isinstance(cached.get("at"), (int, float)) and 0 <= now - cached["at"] < KP_OLD:
        return cached.get("kp")
    save(path, {"at": now, "kp": kp})
    return kp


def aurora(location, now):
    """{"kp": number|None, "likely": bool} for the location (coordinates are used, never returned)."""
    kp = current_kp(now)
    likely = False
    if kp is not None:
        try:
            lat, lon, _, _ = resolve(location, now)
            need = kp_needed(lat, lon)
            likely = need is not None and kp >= need
        except Exception:
            pass
    return {"kp": kp, "likely": likely}


def fetch(lat, lon):
    """The raw metric forecast (Celsius, km/h); units are converted on output."""
    q = {
        "latitude": "%.4f" % lat, "longitude": "%.4f" % lon, "timezone": "auto", "forecast_days": 6, "forecast_hours": 24,
        "current": "temperature_2m,apparent_temperature,relative_humidity_2m,is_day,weather_code,wind_speed_10m",
        "hourly": "temperature_2m,weather_code,is_day,precipitation_probability",
        "daily": "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max",
        "temperature_unit": "celsius", "wind_speed_unit": "kmh",
    }
    return get_json("forecast", "https://api.open-meteo.com/v1/forecast?" + urllib.parse.urlencode(q))


def at(seq, i):
    return seq[i] if isinstance(seq, list) and i < len(seq) else None


def parse_time(s):
    try:
        return datetime.datetime.strptime(str(s)[:16], "%Y-%m-%dT%H:%M")
    except ValueError:
        return None


def shape(entry, units, now):
    """Cache entry {raw, name, source, at} -> the output for `units`, with past days / hours dropped (they matter for a stale answer)."""
    raw, fetched = entry["raw"], entry["at"]
    imperial = units == "imperial"
    cur, day = raw["current"], raw.get("daily") or {}
    hrs = raw.get("hourly") or {}

    def t(v):
        return None if not isinstance(v, (int, float)) else round(v * 9 / 5 + 32, 1) if imperial else v

    def w(v):
        return None if not isinstance(v, (int, float)) else round(v / 1.609344, 1) if imperial else v

    # wall clock at the location now: the time of the answer plus the age of the answer
    base = parse_time(cur.get("time")) or datetime.datetime.fromtimestamp(fetched, datetime.timezone.utc).replace(tzinfo=None)
    local = base + datetime.timedelta(seconds=max(0, now - fetched))
    today = local.date()
    ck, ct = describe(cur.get("weather_code"))
    daily = []
    for i, date in enumerate(day.get("time") or []):
        try:
            rel = (datetime.date.fromisoformat(date) - today).days
        except ValueError:
            continue
        if rel < 0:
            continue
        k, tx = describe(at(day.get("weather_code"), i))
        daily.append({
            "date": date, "rel": rel if rel < 2 else None, "kind": k, "text": tx,
            "min": t(at(day.get("temperature_2m_min"), i)), "max": t(at(day.get("temperature_2m_max"), i)),
            "pop": at(day.get("precipitation_probability_max"), i),
        })
    hourly = []
    start = local.replace(minute=0, second=0, microsecond=0)
    for i, ts in enumerate(hrs.get("time") or []):
        when = parse_time(ts)
        if when is None or when < start:
            continue
        k, tx = describe(at(hrs.get("weather_code"), i))
        hourly.append({
            "time": when.strftime("%H:%M"), "temp": t(at(hrs.get("temperature_2m"), i)), "kind": k, "text": tx,
            "isDay": bool(at(hrs.get("is_day"), i) if at(hrs.get("is_day"), i) is not None else 1),
            "pop": at(hrs.get("precipitation_probability"), i),
        })
        if len(hourly) == HOURS:
            break
    return {
        "ok": True, "stale": False, "error": "", "generatedAt": fetched, "units": units,
        "unitsLabel": {"temp": "°F" if imperial else "°C", "wind": "mph" if imperial else "km/h"},
        "location": {"name": entry["name"], "source": entry["source"]},
        "current": {
            "temp": t(cur["temperature_2m"]), "tempC": cur["temperature_2m"], "feels": t(cur.get("apparent_temperature")),
            "humidity": cur.get("relative_humidity_2m"), "wind": w(cur.get("wind_speed_10m")),
            "isDay": bool(cur.get("is_day", 1)), "kind": ck, "text": ct,
        },
        "hourly": hourly, "daily": daily,
    }


def run(location, units, force, max_age, now=None, kp=False):
    now = time.time() if now is None else now
    out = _run(location, units, force, max_age, now)
    if kp and out.get("ok"):
        out["aurora"] = aurora(location, now)
    return out


def _run(location, units, force, max_age, now):
    units = "imperial" if units == "imperial" else "metric"
    key = location.strip().lower()
    last_path = os.path.join(CACHE, "last.json")
    last = load(last_path)
    good = last if isinstance(last, dict) and last.get("key") == key and isinstance(last.get("raw"), dict) \
        and isinstance(last.get("at"), (int, float)) and 0 <= now - last["at"] < STALE_MAX else None
    try:
        if good and not force and now - good["at"] < max_age:
            return shape(good, units, now)
        try:
            lat, lon, name, src = resolve(location, now)
            raw = fetch(lat, lon)
            if not isinstance(raw, dict):
                raise OSError("bad forecast answer")
            entry = {"key": key, "raw": raw, "name": name, "source": src, "at": now}
            out = shape(entry, units, now)
        except Exception as e:
            msg = str(e) if isinstance(e, Fail) else "Weather service unreachable"
            if good:
                return dict(shape(good, units, now), stale=True, error=msg)
            return {"ok": False, "stale": False, "error": msg, "generatedAt": now, "units": units}
        save(last_path, entry)
        return out
    except Exception:                # a corrupt cache entry
        return {"ok": False, "stale": False, "error": "Weather service unreachable", "generatedAt": now, "units": units}


def main(argv):
    def opt(name, default):
        return argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else default
    try:
        max_age = float(opt("--max-age", "600"))
    except ValueError:
        max_age = 600.0
    print(json.dumps(run(opt("--location", ""), opt("--units", "metric"), "--force" in argv, max_age, kp="--kp" in argv)))


if __name__ == "__main__":
    main(sys.argv[1:])
