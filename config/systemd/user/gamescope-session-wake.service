[Unit]
Description=Wake/sleep the TV, switch input, and force a VT refresh around a gamescope-session
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=%t/gamescope-environment

[Service]
Type=oneshot
# RemainAfterExit is what makes ExecStop fire at all: a plain oneshot is
# already "inactive" the instant ExecStart returns, so without this,
# graphical-session.target stopping (i.e. leaving gamescope-session) would
# have nothing to actually stop.
RemainAfterExit=yes
ExecStart=/home/kreejzak/.config/hypr/scripts/gamescope-session-wake.sh
ExecStop=/home/kreejzak/.config/hypr/scripts/tv-sleep.sh
# Multiple ExecStart=/ExecStop= lines run in order (Type=oneshot allows
# more than one ExecStart=, and ExecStop= always allows more than one) --
# this second pair is an independent concern (Home Assistant notification,
# not TV power) firing on the exact same start/end of the gamescope-
# session lifecycle. See gamescope-webhook-notify.sh.
ExecStart=/home/kreejzak/.config/hypr/scripts/gamescope-webhook-notify.sh true
ExecStop=/home/kreejzak/.config/hypr/scripts/gamescope-webhook-notify.sh false

[Install]
WantedBy=graphical-session.target
