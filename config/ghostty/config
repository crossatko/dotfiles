# --- Font ---
font-family = "Paper Mono"
font-size = 18
# WC3 Icons colour font for the zellij-wc3cz tab bar (ghostty ignores fontconfig for these emoji codepoints).
# The Wide variant fills 2 cells x the font's natural height (adjust-cell-height adds bands above/below).
font-codepoint-map = U+1FA70-U+1FAD6=WC3 Icons Wide
font-codepoint-map = U+1F7E0-U+1F7E6=WC3 Icons Wide
# Linux: kitty's modify_font cell_height 110%; macos.conf overrides it
adjust-cell-height = 2
adjust-cell-width = 0

# --- Colors: generated, edit ~/.config/theme/theme.toml ---
config-file = ?~/.config/theme/out/ghostty

# --- Window ---
background-opacity = 0.8
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
# Linux (Hyprland draws the borders): no GTK titlebar; macos.conf puts the default back
window-decoration = none
# kitty: confirm_os_window_close 0; macos.conf puts the default back
confirm-close-surface = false
# Per-machine overrides (git-ignored, e.g. background-opacity on the battlestation, like kitty/host.py)
config-file = ?~/.config/ghostty/host.local

# --- Keybinds (Linux): no Ghostty shortcuts (tabs, splits, windows...), zellij manages everything. Only these stay,
# like macos.conf on the Mac (it clears these and sets the super+ ones, loaded after this file).
keybind = clear
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = copy=copy_to_clipboard:mixed
keybind = paste=paste_from_clipboard
keybind = ctrl+==increase_font_size:1
keybind = ctrl++=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+q=quit
keybind = ctrl+shift+,=reload_config

# --- Scrollback ---
scrollback-limit = 10000
