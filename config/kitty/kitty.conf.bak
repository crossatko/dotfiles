# Generated by Home Manager.
# See https://sw.kovidgoyal.net/kitty/conf.html
# font_family ComicShannsMono Nerd Font


# Colors come from ~/.config/theme (edit theme.toml there)
include ~/.config/theme/out/kitty.conf

# Shell integration is sourced and configured manually
shell_integration no-rc

background_opacity 0.75
dynamic_background_opacity yes
# per-host overrides (e.g. more transparent on the battlestation)
geninclude host.py

font_family      family="Paper Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto

font_size 18
# line height

modify_font cell_height 110%

confirm_os_window_close 0

# WC3 race icons for the zellij claude-tabs plugin (font installed to ~/.local/share/fonts by the
# package setup.sh, ~/code/crossatko/zellij-wc3cz-claude).
# Side effect: the coloured-circle emoji U+1F7E0..U+1F7E6 render as WC3 icons in kitty.
# Harmless if the font is not installed (symbol_map is then ignored).
symbol_map U+1F7E0-U+1F7E6 WC3 Icons
symbol_map U+1FA70-U+1FAD6 WC3 Icons

window_padding_width 0 
# 15

