# Update system (yay) and flatpaks. Prompts for confirmation unless -y is passed.
update() {
  if [[ $OSTYPE == darwin* ]]; then
    brew update && brew upgrade
    return
  fi
  if [[ "$1" != "-y" ]]; then
    read -k 1 "REPLY?Update system and flatpaks? [Y/n] "
    [[ "$REPLY" != $'\n' ]] && echo
    [[ "$REPLY" == [nN] ]] && return 1
  fi
  yay -Syu --noconfirm && flatpak update -y
}
