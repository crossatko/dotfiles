# NixOS
result
result-*

# Node modules (for opencode config)
config/opencode/node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets — never commit personal env vars / API keys.
# Real values live in ~/.config/secrets/env (sourced from .zshrc).
**/secrets/
**/secrets/*
*.local
.zshrc.local
hypr/.secrets
config/hypr/.secrets
config/hypr/scripts/diacritics.log
hypr/.secrets

# WiVRn pairing secrets — cookie is an auth token, known_keys ties to real devices.
config/wivrn/cookie
config/wivrn/known_keys.json
config/theme/out/*.tmp
__pycache__/

# claude-tabs zellij plugin: standalone package (~/code/crossatko/zellij-wc3cz-claude); its setup.sh
# creates the host-local link config/zellij/plugins/claude-tabs -> the checkout
config/zellij/plugins/
# per-host theme outputs (alphas depend on the running compositor; theme.py render writes them)
config/theme/out/host/
