# Node modules (for opencode config)
config/opencode/node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets — never commit personal env vars / API keys.
# Real values live in ~/.config/secrets/env (sourced from .zshrc).
**/secrets/
**/secrets/*
*.local
.zshrc.local
hypr/.secrets
config/hypr/.secrets
hypr/.secrets

# WiVRn pairing secrets — cookie is an auth token, known_keys ties to real devices.
config/wivrn/cookie
config/wivrn/known_keys.json
# per-machine theme: generated output (seeded from the committed config/theme/default/) and the wallpaper selection
config/theme/out/
config/theme/theme.local.toml
config/theme/blobs/target/
__pycache__/
scratchpad/
